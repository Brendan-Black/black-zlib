# black-rust: owned by cargo black; edit it in black-rust, not here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = tab
indent_size = 2
tab_width = 2

[*.{yml,yaml,toml,json}]
indent_style = space
indent_size = 2

[*.{bat,ps1}]
end_of_line = crlf
